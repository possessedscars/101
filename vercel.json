{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "functions": {
    "api/*.mjs": {
      "runtime": "nodejs22.x"
    }
  },
  "rewrites": [
    {
      "source": "/api/auth/login",
      "destination": "/api/auth-login.mjs"
    },
    {
      "source": "/api/auth/me",
      "destination": "/api/auth-me.mjs"
    },
    {
      "source": "/api/auth/logout",
      "destination": "/api/auth-logout.mjs"
    },
    {
      "source": "/api/admin/overview",
      "destination": "/api/admin-overview.mjs"
    },
    {
      "source": "/api/orders/create",
      "destination": "/api/orders-create.mjs"
    }
  ]
}
